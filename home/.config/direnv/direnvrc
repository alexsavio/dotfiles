VENVS_DIR="$HOME/.virtualenvs"

layout_uv() {
    # Derive a unique venv name from the project path
    # e.g., /Users/alexandre/projects/foo/bar → projects-foo-bar
    local venv_name
    venv_name=$(pwd | sed "s|$HOME/||; s|/|-|g")
    VIRTUAL_ENV="${UV_PROJECT_ENVIRONMENT:-$VENVS_DIR/$venv_name}"

    if [[ ! -d "$VIRTUAL_ENV" ]]; then
        log_status "No virtual environment exists. Creating $VIRTUAL_ENV"
        mkdir -p "$VENVS_DIR"
        uv venv "$VIRTUAL_ENV"
    fi

    PATH_add "$VIRTUAL_ENV/bin"
    export UV_ACTIVE=1
    export VIRTUAL_ENV
}
