// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "cli_default_open_behavior": "new_window",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "which_key": {
    "enabled": true,
  },
  "inlay_hints": {
    "enabled": true,
  },
  "auto_install_extensions": {
    "sql": true,
    "ansible": true,
    "jinja2": true,
    "golangci-lint": true,
    "env": true,
    "ini": true,
    "log": true,
    "ssh-config": true,
    "codebook": true,
    "markdown-oxide": true,
    "rose-pine-theme": true,
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "icon_theme": "Catppuccin Macchiato",
  "agent": {
    "dock": "left",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.6",
      "enable_thinking": false
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-opus-4.6",
    },
  },
  "ui_font_size": 18,
  "buffer_font_size": 18,
  "theme": {
    "mode": "dark",
    "light": "Rosé Pine Dawn",
    "dark": "Rosé Pine",
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
    },
  },
  "file_types": {
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/host_vars/*.yml",
      "**/host_vars/*.yaml",
      "**/playbooks/*.yml",
      "**/playbooks/*.yaml",
      "**playbook*.yml",
      "**playbook*.yaml",
    ],
  },
  "lsp": {
    "ansible-language-server": {
      "settings": {
        "ansible": {
          "path": "ansible",
        },
        "executionEnvironment": {
          "enabled": false,
        },
        "python": {
          "interpreterPath": "python3",
        },
        "validation": {
          "enabled": true,
          "lint": {
            "enabled": true,
            "path": "ansible-lint",
          },
        },
      },
    },
  },
}
